# Local SQLite database placeholder. Production should use Postgres.
DATABASE_URL="file:./dev.db"

# Production database. Use Neon/Supabase/Vercel Postgres connection string.
# POSTGRES_URL takes priority over DATABASE_URL when both exist.
# POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# KASIRKITA_POSTGRES_STATE_KEY="production"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-this-secret-minimum-32-characters"
KASIRKITA_AUTH_SECRET="change-this-secret-minimum-32-characters"
# Separate AES-256 key for provider credentials and MFA secrets.
# Generate with: openssl rand -base64 32
KASIRKITA_DATA_ENCRYPTION_KEY=""
CRON_SECRET="set-a-random-secret-for-scheduled-backups"
# Dedicated private Vercel Blob store, separate from Neon and public product images.
KASIRKITA_BACKUP_BLOB_STORE_ID=""
# Optional alternative to Vercel OIDC + store id.
KASIRKITA_BACKUP_BLOB_READ_WRITE_TOKEN=""
# Generate with: openssl rand -base64 32
KASIRKITA_BACKUP_ENCRYPTION_KEY=""
KASIRKITA_BACKUP_RETENTION_DAYS="30"

# Shared counters are mandatory for public online-store checkout in production.
# Configure either the REST pair or REDIS_URL; do not leave both options empty.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# REDIS_URL="redis://default:PASSWORD@HOST:6379"

# Cloudflare Turnstile for public online-store checkout.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES="kasir-kita.com,www.kasir-kita.com"

# One-time Owner bootstrap for a completely empty database. Use unique values,
# then remove these variables after the Owner has been created successfully.
KASIRKITA_BOOTSTRAP_OWNER_USERNAME=""
KASIRKITA_BOOTSTRAP_OWNER_EMAIL=""
KASIRKITA_BOOTSTRAP_OWNER_PASSWORD=""
KASIRKITA_BOOTSTRAP_OWNER_NAME="Owner KasirKita"
KASIRKITA_BOOTSTRAP_OWNER_SHOP_NAME="KasirKita"

# Email verification for /register. Verify kasir-kita.com in Resend first.
RESEND_API_KEY=""
KASIRKITA_EMAIL_FROM="KasirKita <customercare@kasir-kita.com>"
